# Copy to .env.local (gitignored) and set your own values.
#
# NEXT_PUBLIC_ vars are inlined into the client bundle at build time, so they
# are read when the build runs, not at page load.

# paf SSE transport (the paf server, default :8090). The UI is a pure
# consumer: paf runs the agent, this file only points the UI at it.
NEXT_PUBLIC_PAF_BASE_URL=http://localhost:8090

# paf ops transport (default :8091) — the restart button. The token must match
# the one your paf server is configured with. Note the NEXT_PUBLIC_ prefix: this
# token ships in the client bundle, so only use this on a trusted network.
NEXT_PUBLIC_PAF_OPS_URL=http://localhost:8091
# Generate one with: openssl rand -hex 32 (set the same value as PAF_OPS_TOKEN on the paf side).
# If blank, the restart button shows "no token" when clicked.
NEXT_PUBLIC_PAF_OPS_TOKEN=

# The agent the UI drives — a spec name paf ships (demo_assistant).
NEXT_PUBLIC_PAF_AGENT=demo_assistant

# Extra dev origins Next should accept, comma-separated, for reaching the UI from
# other machines in dev (a Tailscale host/IP, a LAN IP, a reverse-proxy name).
# Loopback is always allowed, so leave this unset for local-only use.
# NEXT_DEV_ORIGINS=my-host.example.ts.net,100.101.102.103
